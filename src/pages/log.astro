---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fmtDate } from '../lib/temp';

const logs = (await getCollection('log')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);

/* 按月分组(§6.5) */
const groups = new Map<string, typeof logs>();
for (const l of logs) {
  const d = l.data.published;
  const key = `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(l);
}
---
<Base title="日志" rail="低温日志">
  <div class="content-col">
    <div class="post-head">
      <div class="post-meta mono"><span>实验室日志</span><span>共 {logs.length} 条</span></div>
      <h1>日志</h1>
      <p class="post-sub">短记录、进展与未经整理的想法。这里允许未完成。</p>
    </div>

    {[...groups.entries()].map(([month, items]) => (
      <section>
        <div class="log-month mono">{month}</div>
        {items.map((l) => (
          <div class="log-entry">
            <span class="log-date">{fmtDate(l.data.published)}</span>
            <p>
              {l.body}
              {l.data.link && <> — <a href={l.data.link}>链接</a></>}
            </p>
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>
