---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  fmtDate, fmtTemp, tempOf, STATUS_LABEL, STATUS_COLOR, CATEGORY_LABEL,
} from '../../lib/temp';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  const sorted = entries.sort((a, b) => a.data.published.getTime() - b.data.published.getTime());
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: sorted[i - 1], next: sorted[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const temp = tempOf(d.status, d.temperature);
const rail = `${d.id} · ${CATEGORY_LABEL[d.category]} · ${fmtTemp(temp)}`;
const h2s = headings.filter((h) => h.depth === 2);

/* 根据正文动态估算阅读时间(CJK 350 字/分,代码及英文 180 词/分) */
const calcReadingMinutes = (text: string) => {
  const clean = text.replace(/```[\s\S]*?```/g, '').trim();
  const cjk = (clean.match(/[\u4e00-\u9fa5]/g) || []).length;
  const en = (clean.match(/[a-zA-Z0-9_\-]+/g) || []).length;
  return Math.max(1, Math.round(cjk / 350 + en / 180));
};
const readMinutes = d.minutes ?? (entry.body ? calcReadingMinutes(entry.body) : 8);

/* 思想脉络与双向反向链接 (Connected Notes & Backlinks) */
const allWriting = await getCollection('writing');
const allLog = await getCollection('log');

const outgoingNotes = allWriting.filter((other) => {
  if (other.id === entry.id) return false;
  return entry.body?.includes(other.data.id) || entry.body?.includes(other.id);
});

const backlinkNotes = allWriting.filter((other) => {
  if (other.id === entry.id) return false;
  return other.body?.includes(d.id) || other.body?.includes(entry.id);
});

const backlinkLogs = allLog.filter((l) => {
  return l.body?.includes(d.id) || l.body?.includes(entry.id);
});

const relatedNotes = allWriting
  .filter((other) => {
    if (other.id === entry.id) return false;
    return (
      other.data.category === d.category &&
      !outgoingNotes.some((o) => o.id === other.id) &&
      !backlinkNotes.some((b) => b.id === other.id)
    );
  })
  .slice(0, 2);

const rawMarkdown = `---
id: ${d.id}
title: "${d.title}"
subtitle: "${d.subtitle || ''}"
category: ${d.category}
status: ${d.status}
temperature: ${d.temperature ?? ''}
published: ${d.published.toISOString().split('T')[0]}
${d.updated ? `updated: ${d.updated.toISOString().split('T')[0]}` : ''}
tags: [${(d.tags || []).join(', ')}]
---

${entry.body || ''}
`;
---
<Base
  title={d.title}
  description={d.excerpt}
  rail={rail}
  thermometer
  temp={temp}
  article={{ published: d.published, updated: d.updated, tags: d.tags }}
>
  <div class={h2s.length || d.notes?.length ? 'with-margin' : ''} id="top">
    <article class="content-col">
      <header class="post-head">
        <div class="post-meta mono">
          <span>
            {d.id} · {CATEGORY_LABEL[d.category]}
          </span>
          <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time>
        </div>
        <h1>{d.title}</h1>
        {d.subtitle && <p class="post-sub">{d.subtitle}</p>}
        <div class="post-info mono">
          <span>{readMinutes} 分钟阅读{d.updated && ` · 更新于 ${fmtDate(d.updated)}`}</span>
          <div class="post-actions">
            <button
              type="button"
              class="export-md-btn mono"
              id="export-md-btn"
              data-filename={`${d.id}-${d.title}.md`}
              data-raw-md={encodeURIComponent(rawMarkdown)}
              title="导出单篇标准 Markdown 原文"
            >
              [导出 .MD]
            </button>
            <button type="button" class="zen-toggle-btn mono" id="zen-toggle-btn" title="开启全心流禅定模式 (快捷键 Z)">
              [禅定 Z]
            </button>
          </div>
        </div>
      </header>

      <dl class="status-bar mono">
        <div class="row">
          <dt>状态</dt>
          <dd>
            <a href="/about/#temperature" title="了解温度系统" style={`color: ${STATUS_COLOR[d.status]}; text-decoration: none;`}>
              {STATUS_LABEL[d.status]} · {fmtTemp(temp)}
            </a>
          </dd>
        </div>
        {d.confidence && <div class="row"><dt>置信</dt><dd>{d.confidence}</dd></div>}
        {d.scope && <div class="row"><dt>范围</dt><dd>{d.scope}</dd></div>}
      </dl>

      {h2s.length > 1 && (
        <details class="mobile-toc mono">
          <summary>目录 · {h2s.length} 节</summary>
          <nav>
            {h2s.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </details>
      )}

      <div class="prose" id="prose-content">
        <Content />
      </div>

      <!-- 灵感 3: 划词即引文气泡 (Inspired by Medium / Readwise) -->
      <div id="quote-bubble" class="quote-bubble mono" aria-hidden="true">
        <button type="button" id="quote-copy-btn" class="quote-btn">
          <span class="quote-icon">“</span> 复制 Markdown 引文
        </button>
      </div>

      {d.notes && d.notes.length > 0 && (
        <aside class="folded-notes" aria-label="作者附注">
          <div class="folded-notes-title mono">作者附注 / NOTES</div>
          <div class="folded-notes-list">
            {d.notes.map((n) => (
              <div class="folded-note-item" id={`folded-note-${n.anchor}`}>
                <span class="anchor mono">注 · {n.anchor}</span>
                <p>{n.text}</p>
              </div>
            ))}
          </div>
        </aside>
      )}

      {d.tempLog && d.tempLog.length > 1 && (
        <div class="temp-log mono">
          温度史 — {d.tempLog.map((t) => `${fmtDate(t.date)} ${STATUS_LABEL[t.status]}`).join(' → ')}
        </div>
      )}

      <!-- 思想脉络与双向反向链接 (Connected Notes & Backlinks) -->
      {(backlinkNotes.length > 0 || backlinkLogs.length > 0 || outgoingNotes.length > 0 || relatedNotes.length > 0) && (
        <aside class="connected-thoughts mono" aria-label="思想脉络与关联思考">
          <div class="connected-head">
            <span class="connected-title">思想脉络 / CONNECTED THOUGHTS</span>
            <span class="connected-badge">{backlinkNotes.length + backlinkLogs.length} 反向引用 · {outgoingNotes.length} 延伸引用</span>
          </div>
          <div class="connected-list">
            {backlinkNotes.map((b) => (
              <a href={`/writing/${b.id}/`} class="connected-item">
                <span class="connected-tag incoming">← 引用了本文</span>
                <span class="connected-id">{b.data.id}</span>
                <span class="connected-item-title">{b.data.title}</span>
              </a>
            ))}
            {backlinkLogs.map((l) => (
              <a href={`/log/#log-${l.id}`} class="connected-item">
                <span class="connected-tag log">← 日志追踪</span>
                <span class="connected-id">{l.id}</span>
                <span class="connected-item-title">实验日志记录</span>
              </a>
            ))}
            {outgoingNotes.map((o) => (
              <a href={`/writing/${o.id}/`} class="connected-item">
                <span class="connected-tag outgoing">延伸参考 →</span>
                <span class="connected-id">{o.data.id}</span>
                <span class="connected-item-title">{o.data.title}</span>
              </a>
            ))}
            {relatedNotes.map((r) => (
              <a href={`/writing/${r.id}/`} class="connected-item">
                <span class="connected-tag related">同温阶笔记 ~</span>
                <span class="connected-id">{r.data.id}</span>
                <span class="connected-item-title">{r.data.title}</span>
              </a>
            ))}
          </div>
        </aside>
      )}

      <nav class="post-nav" aria-label="相邻文章">
        <div>
          {prev && (
            <a href={`/writing/${prev.id}/`}>
              <span class="nav-id mono">← {prev.data.id}</span>
              {prev.data.title}
            </a>
          )}
        </div>
        <div class="next">
          {next && (
            <a href={`/writing/${next.id}/`}>
              <span class="nav-id mono">{next.data.id} →</span>
              {next.data.title}
            </a>
          )}
        </div>
      </nav>

      <div class="post-back-top">
        <a href="#top" class="mono">↑ 顶端 / TOP</a>
      </div>
    </article>

    {(h2s.length > 0 || (d.notes && d.notes.length > 0)) && (
      <aside class="margin-col">
        <div class="toc">
          <!-- 灵感 4: 动态阅读节奏倒计时 -->
          <div class="reading-pacing mono" id="reading-pacing" data-initial-minutes={readMinutes} data-initial-temp={temp ?? 0}>
            <div class="pacing-row">
              <span class="pacing-label">阅读节奏</span>
              <span class="pacing-temp" id="pacing-temp">{fmtTemp(temp)}</span>
            </div>
            <div class="pacing-status" id="pacing-time">剩余 ~{readMinutes} 分钟</div>
            <div class="pacing-track">
              <div class="pacing-fill" id="pacing-fill"></div>
            </div>
          </div>

          {h2s.length > 0 && (
            <>
              <div class="lab-label">目录</div>
              <nav class="mono">
                {h2s.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
              </nav>
            </>
          )}
          {d.notes?.map((n) => (
            <div class="margin-note" data-anchor={n.anchor} id={`note-${n.anchor}`}>
              <span class="anchor mono">注 · {n.anchor}</span>
              <br />{n.text}
            </div>
          ))}
        </div>
      </aside>
    )}
  </div>

  <script>
    /* 目录 scroll-spy + 4 大阅读体验系统 */
    let spy: IntersectionObserver | undefined;
    let zenObserver: IntersectionObserver | undefined;

    document.addEventListener('astro:page-load', () => {
      spy?.disconnect();
      zenObserver?.disconnect();

      const articleTitle = document.querySelector('h1')?.textContent || '';
      const prose = document.getElementById('prose-content');

      /* 0. 导出 Markdown 原文 */
      const exportBtn = document.getElementById('export-md-btn');
      exportBtn?.addEventListener('click', () => {
        const rawMd = decodeURIComponent(exportBtn.getAttribute('data-raw-md') || '');
        const filename = exportBtn.getAttribute('data-filename') || 'article.md';
        const blob = new Blob([rawMd], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        exportBtn.textContent = '[已导出 ✓]';
        setTimeout(() => (exportBtn.textContent = '[导出 .MD]'), 2000);
      });


      /* 1. 目录 scroll-spy */
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.margin-col .toc nav a');
      if (tocLinks.length) {
        spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                tocLinks.forEach((l) =>
                  l.classList.toggle('active', decodeURIComponent(l.hash) === `#${e.target.id}`)
                );
              }
            });
          },
          { rootMargin: '0px 0px -70% 0px' }
        );
        tocLinks.forEach((l) => {
          const el = document.getElementById(decodeURIComponent(l.hash.slice(1)));
          if (el) spy!.observe(el);
        });
      }

      /* 2. iA Writer 灵感: 全心流禅定模式 (Zen Focus Mode) */
      const zenBtn = document.getElementById('zen-toggle-btn');
      const toggleZen = () => {
        const isZen = document.body.classList.toggle('zen-mode');
        if (zenBtn) zenBtn.textContent = isZen ? '[退出禅定 ESC]' : '[禅定 Z]';
      };
      zenBtn?.addEventListener('click', toggleZen);

      // 禅定模式下聚焦视口段落
      if (prose) {
        const paragraphs = prose.querySelectorAll<HTMLElement>('p, h2, h3, pre, blockquote, ul, ol');
        zenObserver = new IntersectionObserver(
          (entries) => {
            if (!document.body.classList.contains('zen-mode')) return;
            entries.forEach((e) => {
              if (e.isIntersecting) {
                paragraphs.forEach((p) => p.classList.remove('zen-active'));
                (e.target as HTMLElement).classList.add('zen-active');
              }
            });
          },
          { rootMargin: '-25% 0px -50% 0px' }
        );
        paragraphs.forEach((p) => {
          zenObserver!.observe(p);
          p.addEventListener('mouseenter', () => {
            if (!document.body.classList.contains('zen-mode')) return;
            paragraphs.forEach((x) => x.classList.remove('zen-active'));
            p.classList.add('zen-active');
          });
        });
      }

      /* 3. Gwern / Edward Tufte 灵感: 边注双向联动探针 (Sidenote Bidirectional Peek) */
      document.querySelectorAll<HTMLElement>('.margin-note').forEach((note) => {
        const anchor = note.dataset.anchor;
        if (!anchor || !prose) return;

        let anchorEls = Array.from(prose.querySelectorAll<HTMLElement>('.sidenote-anchor')).filter(
          (el) => el.dataset.anchor === anchor
        );

        if (anchorEls.length === 0) {
          const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
          let node: Text | null;
          while ((node = walker.nextNode() as Text | null)) {
            const parent = node.parentElement;
            if (
              parent &&
              (parent.tagName === 'A' ||
                parent.tagName === 'CODE' ||
                parent.tagName === 'PRE' ||
                parent.classList.contains('sidenote-anchor'))
            ) {
              continue;
            }
            const idx = node.nodeValue?.indexOf(anchor) ?? -1;
            if (idx !== -1 && node.nodeValue) {
              const before = node.nodeValue.slice(0, idx);
              const match = node.nodeValue.slice(idx, idx + anchor.length);
              const after = node.nodeValue.slice(idx + anchor.length);

              const span = document.createElement('span');
              span.className = 'sidenote-anchor';
              span.dataset.anchor = anchor;
              span.title = `查看边注: ${note.textContent?.replace('注 · ' + anchor, '').trim()}`;
              span.innerHTML = `${match}<sup class="sidenote-sup mono">注</sup>`;

              const frag = document.createDocumentFragment();
              if (before) frag.appendChild(document.createTextNode(before));
              frag.appendChild(span);
              if (after) frag.appendChild(document.createTextNode(after));

              node.replaceWith(frag);
              anchorEls = [span];
              break;
            }
          }
        }

        anchorEls.forEach((a) => {
          a.addEventListener('mouseenter', () => {
            note.classList.add('highlight-note');
            note.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          a.addEventListener('mouseleave', () => {
            note.classList.remove('highlight-note');
          });
          a.addEventListener('click', () => {
            if (window.innerWidth < 1280) {
              const folded = document.getElementById(`folded-note-${anchor}`);
              if (folded) {
                folded.scrollIntoView({ behavior: 'smooth', block: 'center' });
                folded.classList.add('highlight-note');
                setTimeout(() => folded.classList.remove('highlight-note'), 2400);
              }
            }
          });
        });

        note.addEventListener('mouseenter', () => {
          anchorEls.forEach((a) => a.classList.add('anchor-active'));
        });
        note.addEventListener('mouseleave', () => {
          anchorEls.forEach((a) => a.classList.remove('anchor-active'));
        });
      });


      /* 4. Medium / Readwise 灵感: 划词即引文 (Copy as Markdown Quote) */
      const quoteBubble = document.getElementById('quote-bubble');
      const copyQuoteBtn = document.getElementById('quote-copy-btn');

      if (quoteBubble && copyQuoteBtn && prose) {
        let currentQuote = '';

        const checkSelection = () => {
          const sel = window.getSelection();
          const text = sel?.toString().trim();
          if (text && text.length >= 4 && sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            const rect = range.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
              currentQuote = text;
              quoteBubble.style.left = `${Math.max(16, rect.left + rect.width / 2)}px`;
              quoteBubble.style.top = `${rect.top - 46}px`;
              quoteBubble.classList.add('visible');
              quoteBubble.setAttribute('aria-hidden', 'false');
              return;
            }
          }
          quoteBubble.classList.remove('visible');
          quoteBubble.setAttribute('aria-hidden', 'true');
        };

        prose.addEventListener('mouseup', () => setTimeout(checkSelection, 50));
        document.addEventListener('selectionchange', () => {
          if (!window.getSelection()?.toString().trim()) {
            quoteBubble.classList.remove('visible');
          }
        });

        copyQuoteBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!currentQuote) return;

          const markdownQuote = `> ${currentQuote}\n>\n> —— 暮羽中《${articleTitle}》${window.location.href}`;
          let ok = false;
          if (navigator.clipboard && window.isSecureContext) {
            try {
              await navigator.clipboard.writeText(markdownQuote);
              ok = true;
            } catch (_) {}
          }
          if (!ok) {
            const ta = document.createElement('textarea');
            ta.value = markdownQuote;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            ok = true;
          }

          copyQuoteBtn.textContent = 'COPIED ✓';
          copyQuoteBtn.classList.add('copied');
          setTimeout(() => {
            copyQuoteBtn.innerHTML = '<span class="quote-icon">“</span> 复制 Markdown 引文';
            copyQuoteBtn.classList.remove('copied');
            quoteBubble.classList.remove('visible');
          }, 1600);
        });
      }

      /* 5. 动态阅读节奏倒计时与降温 (Pacing Countdown) */
      const pacingEl = document.getElementById('reading-pacing');
      const pacingTime = document.getElementById('pacing-time');
      const pacingTemp = document.getElementById('pacing-temp');
      const pacingFill = document.getElementById('pacing-fill');

      if (pacingEl && pacingTime && pacingTemp && pacingFill) {
        const initialMin = parseFloat(pacingEl.dataset.initialMinutes || '8');
        const initialT = parseFloat(pacingEl.dataset.initialTemp || '8');

        const updatePacing = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
          const remainMin = Math.max(0, Math.round(initialMin * (1 - p)));
          const curT = !Number.isNaN(initialT) ? (initialT - 2 * p).toFixed(1) + '°C' : '—°C';

          pacingFill.style.width = `${Math.round(p * 100)}%`;
          pacingTemp.textContent = curT;

          if (p >= 0.95) {
            pacingTime.textContent = '已完全冷却 · 阅读完成';
          } else {
            pacingTime.textContent = `剩余 ~${remainMin} 分钟 (${Math.round(p * 100)}%)`;
          }
        };

        window.addEventListener('scroll', updatePacing, { passive: true });
        updatePacing();
      }
    });
  </script>
</Base>
