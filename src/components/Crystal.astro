---
/* 同心等温轨道仪 (Concentric Isotherm Orbit System) — 方案 1
 * 思想相变天体仪: 核心为 0°C 绝对零度基准,
 * 4 条等温圆环依次向外延展 (4.2°C 结晶态 → 8.4°C 已验证 → 14.0°C 探索中 → 19.5°C 气态)。
 * 每一篇文章是对应轨道上的物态质点,四象限均衡分布,方圆相谐。 */
import { getCollection } from 'astro:content';
import { tempOf, STATUS_COLOR, STATUS_LABEL } from '../lib/temp';

const posts = (await getCollection('writing')).sort(
  (a, b) => a.data.published.getTime() - b.data.published.getTime()
);

const W = 460, H = 460;
const cx = 230, cy = 230;

/* 四大固定等温轨道 (半径递增，与状态色温 1:1 映射) */
const ORBITS = [
  { status: 'stable', temp: 4.2, label: '4.2°C', name: '结晶', r: 70, color: 'var(--teal)' },
  { status: 'tested', temp: 8.4, label: '8.4°C', name: '已验证', r: 116, color: 'var(--accent)' },
  { status: 'exploring', temp: 14.0, label: '14.0°C', name: '探索', r: 162, color: 'var(--blue)' },
  { status: 'draft', temp: 19.5, label: '19.5°C', name: '气态', r: 208, color: 'var(--mauve)' },
];

const rad = (deg: number) => (deg * Math.PI) / 180;

/* 四象限平衡角配置: 让 4 篇文章在四个象限中形成重力平衡 */
const QUADRANT_ANGLES = [-40, 48, 142, 222]; // 保证各占一象限

const nodes = posts.map((p, i) => {
  const temp = tempOf(p.data.status, p.data.temperature);
  const color = STATUS_COLOR[p.data.status];
  
  // 查找对应等温环半径
  const matchedOrbit = ORBITS.find((o) => o.status === p.data.status) ?? ORBITS[1];
  const r = matchedOrbit.r;

  // 计算节点极坐标
  const angleDeg = QUADRANT_ANGLES[i % QUADRANT_ANGLES.length];
  const a = rad(angleDeg);
  const nx = cx + r * Math.cos(a);
  const ny = cy + r * Math.sin(a);

  // 轨道切线引导微弧 (沿轨道前后各延伸 14°)
  const arcA1 = rad(angleDeg - 14);
  const arcA2 = rad(angleDeg + 14);
  const arcX1 = cx + r * Math.cos(arcA1);
  const arcY1 = cy + r * Math.sin(arcA1);
  const arcX2 = cx + r * Math.cos(arcA2);
  const arcY2 = cy + r * Math.sin(arcA2);

  // 标签排版位置 (根据象限自适应锚点)
  const isRight = nx >= cx;
  const lx = isRight ? nx + 12 : nx - 12;
  const ly = ny + 4;
  const textAnchor = isRight ? 'start' : 'end';

  return {
    href: `/writing/${p.id}/`,
    id: p.data.id,
    title: p.data.title,
    fullTitle: `${p.data.id} · ${p.data.title} · ${STATUS_LABEL[p.data.status]} · ${temp == null ? '—°C' : temp.toFixed(1) + '°C'}`,
    color,
    status: p.data.status,
    orbitRadius: r,
    nx: nx.toFixed(1),
    ny: ny.toFixed(1),
    arcX1: arcX1.toFixed(1),
    arcY1: arcY1.toFixed(1),
    arcX2: arcX2.toFixed(1),
    arcY2: arcY2.toFixed(1),
    lx: lx.toFixed(1),
    ly: ly.toFixed(1),
    textAnchor,
    label: `${p.data.id} · ${temp == null ? '—°C' : temp.toFixed(1) + '°C'}`,
    delay: (0.15 + i * 0.25).toFixed(2),
  };
});
---
<div class="isotherm-stage" id="isothermStage">
  <svg class="crystal isotherm-dial" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="同心等温轨道仪">
    <defs>
      <!-- 冷夜同心微光 -->
      <radialGradient id="orbit-ambient-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.15" />
        <stop offset="35%" stop-color="var(--blue)" stop-opacity="0.06" />
        <stop offset="70%" stop-color="var(--bg-0)" stop-opacity="0.02" />
        <stop offset="100%" stop-color="var(--bg-0)" stop-opacity="0" />
      </radialGradient>
      <!-- 雷达扫描扇形拖尾 -->
      <linearGradient id="radar-sweep-fan" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.16" />
        <stop offset="60%" stop-color="var(--blue)" stop-opacity="0.04" />
        <stop offset="100%" stop-color="var(--blue)" stop-opacity="0" />
      </linearGradient>
      <!-- 质点冷光滤镜 -->
      <filter id="orbit-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="2.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- 背景冷场 -->
    <circle cx={cx} cy={cy} r="215" fill="url(#orbit-ambient-glow)" class="dial-ambient" />

    <!-- 360° 深夜雷达冷光巡航指引扇 -->
    <g class="radar-arm">
      <!-- 扫掠扇形余辉 (18度微弱扇面) -->
      <path d="M 230 230 L 230 18 A 212 212 0 0 0 166 28 Z"
            fill="url(#radar-sweep-fan)" />
      <!-- 雷达前缘发光射线 -->
      <line x1={cx} y1={cy} x2={cx} y2="18"
            stroke="var(--accent)" stroke-width="1.2" opacity="0.65" />
    </g>

    <!-- 十字精密校准准星 -->
    <g class="crosshairs" opacity="0.3">
      <line x1={cx} y1="20" x2={cx} y2="440" stroke="var(--line)" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="20" y1={cy} x2="440" y2={cy} stroke="var(--line)" stroke-width="1" stroke-dasharray="3 4" />
      <!-- 边缘罗盘标尺短刻度 -->
      <line x1={cx} y1="14" x2={cx} y2="24" stroke="var(--ink-2)" stroke-width="1.2" />
      <line x1={cx} y1="436" x2={cx} y2="446" stroke="var(--ink-2)" stroke-width="1.2" />
      <line x1="14" y1={cy} x2="24" y2={cy} stroke="var(--ink-2)" stroke-width="1.2" />
      <line x1="436" y1={cy} x2="446" y2={cy} stroke="var(--ink-2)" stroke-width="1.2" />
    </g>

    <!-- 四大同心等温线 (Isotherm Rings, 带差速微流动) -->
    {ORBITS.map((o, idx) => (
      <g class={`orbit-track orbit-${o.status}`} data-radius={o.r}>
        <!-- 基础虚线轨道 -->
        <circle cx={cx} cy={cy} r={o.r} fill="none"
                stroke={o.color} stroke-width="1" stroke-dasharray="3 5"
                class={`orbit-ring orbit-ring-${idx + 1}`} opacity="0.32" />
        <!-- 垂直轴上的温度刻度读数 -->
        <text x={cx + 4} y={cy - o.r + 3} class="orbit-axis-label mono" fill={o.color}>
          {o.label}
        </text>
      </g>
    ))}

    <!-- 文章质点与切向速度微弧 -->
    {nodes.map((n, idx) => (
      <g class="orbit-node-group" data-orbit-radius={n.orbitRadius}>
        <a href={n.href}>
          <!-- 触控热区 -->
          <circle cx={n.nx} cy={n.ny} r="22" fill="transparent" class="orbit-hitbox" />

          <!-- 轨道切向短弧线 (强调轨道运动感) -->
          <path d={`M ${n.arcX1} ${n.arcY1} A ${n.orbitRadius} ${n.orbitRadius} 0 0 1 ${n.arcX2} ${n.arcY2}`}
                fill="none" stroke={n.color} stroke-width="1.6" opacity="0.75"
                class="orbit-tangent-arc" />

          <!-- 信标回响波纹 (Beacon Ping Echo) -->
          <circle cx={n.nx} cy={n.ny} r="7.5" fill="none" stroke={n.color}
                  class="node-beacon-ripple"
                  style={`animation-delay: ${(+n.delay + idx * 0.6).toFixed(2)}s;`} />

          <!-- 质点外捕获环 -->
          <circle cx={n.nx} cy={n.ny} r="7.5" fill="none" stroke={n.color} stroke-width="0.8"
                  class="node-capture-ring" opacity="0.5"
                  style={`animation-delay: ${n.delay}s;`} />

          <!-- 质点实体冷核 -->
          <circle cx={n.nx} cy={n.ny} r="3.2" fill={n.color} filter="url(#orbit-glow)"
                  class="node-point"
                  style={`animation-delay: ${n.delay}s;`}>
            <title>{n.fullTitle}</title>
          </circle>

          <!-- 极简等宽标注 -->
          <g class="node-label-group" style={`animation-delay: ${(+n.delay + 0.3).toFixed(2)}s;`}>
            <text x={n.lx} y={n.ly} class="node-label mono" text-anchor={n.textAnchor}>
              {n.label}
            </text>
          </g>
        </a>
      </g>
    ))}

    <!-- 核心原点：0°C 绝对零度校准核 -->
    <circle cx={cx} cy={cy} r="14" fill="none" stroke="var(--line)" stroke-width="0.7" stroke-dasharray="2 3" opacity="0.4" />
    <circle cx={cx} cy={cy} r="5.5" fill="none" stroke="var(--accent)" stroke-width="0.8" opacity="0.6" />
    <circle cx={cx} cy={cy} r="2" fill="var(--accent)" />
    <text x={cx} y={cy + 24} class="mono zero-kelvin-label" text-anchor="middle" fill="var(--ink-2)" opacity="0.5">
      0°C 基准
    </text>
  </svg>
</div>
