---
import Mark from './Mark.astro';

const nav = [
  { href: '/writing/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/log/', label: '日志' },
  { href: '/about/', label: '关于' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="brand">
    <a href="/" aria-label="LowTemp Notes 首页"><Mark /></a>
    <a href="/" class="brand-name">LOWTEMP</a>
  </div>
  <nav class="site-nav" aria-label="主导航">
    {nav.map((n) => (
      <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换明暗模式">浅色</button>
  </nav>
</header>

<script>
  /* 明暗切换(§11)。视图切换后模块脚本不重跑、<html> 属性被替换,
     所以用 astro:page-load:每次换页都重新恢复主题并给新按钮绑事件 */
  document.addEventListener('astro:page-load', () => {
    const root = document.documentElement;
    root.dataset.theme = localStorage.getItem('theme') || 'dark';
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const sync = () => {
      btn.textContent = root.dataset.theme === 'light' ? '深色' : '浅色';
    };
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });
    sync();
  });
</script>
