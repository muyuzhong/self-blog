---
import { fmtDate, fmtTemp, tempOf, STATUS_COLOR, CATEGORY_LABEL } from '../lib/temp';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'writing'> }
const { entry } = Astro.props;
const d = entry.data;
const temp = tempOf(d.status, d.temperature);
const deprecated = d.status === 'deprecated';
---
<li class="archive-item" data-category={d.category}>
  <a href={`/writing/${entry.id}/`}>
    <div class="archive-meta mono">
      <span>
        {d.id} · {CATEGORY_LABEL[d.category]} ·
        <span class="temp" style={`color: ${STATUS_COLOR[d.status]}`}>{fmtTemp(temp)}</span>
      </span>
      <time datetime={d.published.toISOString()}>{fmtDate(d.published)}</time>
    </div>
    <h3 class:list={['archive-title', { deprecated }]}>{d.title}</h3>
    {d.subtitle && <p class="archive-sub">{d.subtitle}</p>}
    <p class="archive-excerpt">{d.excerpt}</p>
    {d.tags.length > 0 && (
      <div class="archive-tags mono">{d.tags.map((t) => t.toUpperCase()).join(' · ')}</div>
    )}
  </a>
</li>
